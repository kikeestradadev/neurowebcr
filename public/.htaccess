RewriteEngine On

# Skip canonical redirects in local development
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)$ [NC]
RewriteRule ^ - [L]

# Force HTTPS dynamically for current host (no hardcoded domain)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Normalize host dynamically: remove "www." for any domain
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Ensure explicit content types for crawler-facing files
AddType application/xml .xml
AddType text/plain .txt

# Local development: disable browser cache to avoid stale HTML/CSS/JS while iterating.
<IfModule mod_headers.c>
    SetEnvIf Host "^(localhost|127\.0\.0\.1)$" IS_LOCAL_DEV
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=IS_LOCAL_DEV
    Header set Pragma "no-cache" env=IS_LOCAL_DEV
    Header set Expires "0" env=IS_LOCAL_DEV
</IfModule>
