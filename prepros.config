{
  "version": "7",
  "about": "Solo auto-refresh local. Sin compilación. Editar archivos en public/.",
  "config": {
    "proxy": {
      "enable": false,
      "target": "",
      "useLocalAssets": false
    },
    "reload": {
      "enable": true,
      "delay": 0,
      "animate": true,
      "afterUpload": false
    },
    "sync": {
      "enable": false,
      "mouse": true,
      "keyboard": true,
      "form": true,
      "scroll": true
    },
    "watcher": {
      "enable": true,
      "maxFiles": 2000,
      "usePolling": false,
      "pollingInterval": 500,
      "extensions": [
        ".html",
        ".htm",
        ".css",
        ".js",
        ".php",
        ".png",
        ".jpg",
        ".jpeg",
        ".gif",
        ".webp",
        ".svg",
        ".ico",
        ".xml",
        ".xsl",
        ".txt"
      ],
      "ignore": {
        "patterns": [
          ".*",
          "node_modules",
          "Prepros Export",
          "scripts"
        ],
        "exceptions": []
      }
    },
    "files": []
  }
}
