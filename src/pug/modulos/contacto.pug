section(id='contacto' class='section-base relative py-20 l:py-28 pattern-dots')
	div(class='main-container')
		div(class='container')
			div(class='bg-nw-surface-muted/60 rounded-3xl p-6 m:p-10 l:p-14 shadow-card border border-nw-surface-muted')
				div(class='grid grid-cols-1 l:grid-cols-2 gap-10 l:gap-16')
					div(class='flex gap-5')
						div(class='w-1.5 shrink-0 bg-nw-accent rounded-full' aria-hidden='true')
						div
							p(class='text-xs l:text-sm font-semibold uppercase tracking-[0.3em] text-nw-accent mb-2')= t.contact.eyebrow
							h2(class='text-3xl l:text-5xl font-bold uppercase tracking-tight leading-tight text-nw-text')= t.contact.title
							p(class='font-secondary mt-4 text-base l:text-lg text-nw-text-muted leading-relaxed')= t.contact.intro
							div(class='contact-actions mt-8')
								a(href=whatsappUrl target='_blank' rel='noopener noreferrer' class='btn-whatsapp contact-actions__item')
									svg(class='w-8 h-8 shrink-0 text-green-500' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true')
										path(d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z')
									div(class='text-left')
										span(class='block text-xs l:text-sm font-semibold uppercase tracking-widest text-nw-text')= t.contact.whatsappTitle
										span(class='block text-sm l:text-base font-medium text-nw-text-muted mt-0.5')= whatsappDisplay
								a(href='mailto:' + contactEmail class='contact-actions__item contact-actions__email')
									svg(class='w-5 h-5 shrink-0 text-nw-accent' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z')
									span(class='contact-actions__email-text')= contactEmail

					div(class='flex flex-col items-center justify-center text-center')
						p(class='text-sm l:text-base font-bold uppercase tracking-[0.2em] text-nw-accent mb-6')= t.contact.qrTitle
						div(class='relative p-6 bg-nw-surface rounded-2xl shadow-card')
							div(class='absolute top-3 left-3 w-8 h-8 border-t-2 border-l-2 border-nw-accent rounded-tl-lg')
							div(class='absolute top-3 right-3 w-8 h-8 border-t-2 border-r-2 border-nw-accent rounded-tr-lg')
							div(class='absolute bottom-3 left-3 w-8 h-8 border-b-2 border-l-2 border-nw-accent rounded-bl-lg')
							div(class='absolute bottom-3 right-3 w-8 h-8 border-b-2 border-r-2 border-nw-accent rounded-br-lg')
							div(class='w-48 h-48 m:w-56 m:h-56 flex items-center justify-center bg-nw-bg rounded-lg overflow-hidden')
								img(
									src=whatsappQrSrc
									alt=t.contact.qrAlt
									class='w-full h-full object-contain p-2'
									width='224'
									height='224'
									loading='lazy'
								)
						p(class='font-secondary text-xs l:text-sm text-nw-text-muted mt-4 max-w-xs')= t.contact.qrHint
						a(href=whatsappUrl target='_blank' rel='noopener noreferrer' class='mt-2 text-xs l:text-sm font-semibold uppercase tracking-widest text-nw-accent hover:underline')= t.contact.openWhatsapp
