section(id='contacto' class='section-base relative py-20 l:py-28 pattern-dots')
	div(class='main-container')
		div(class='container')
			div(class='bg-nw-surface-muted/60 rounded-3xl p-6 m:p-10 l:p-14 shadow-card border border-nw-surface-muted')
				div(class='grid grid-cols-1 l:grid-cols-2 gap-10 l:gap-16')
					div(class='flex gap-4 m:gap-5')
						div(class='hidden m:block w-1.5 shrink-0 bg-nw-accent rounded-full' aria-hidden='true')
						div
							p(class='text-xs l:text-sm font-semibold uppercase tracking-[0.3em] text-nw-accent mb-2')= t.contact.eyebrow
							h2(class='text-2xl m:text-3xl l:text-5xl font-bold uppercase tracking-tight leading-tight text-nw-text')= t.contact.title
							p(class='font-secondary mt-4 text-base l:text-lg text-nw-text-muted leading-relaxed')= t.contact.intro
							div(class='contact-actions mt-8')
								button(type='button' class='btn-whatsapp contact-actions__item contact-cta-trigger' data-open-lead-modal='whatsapp' data-whatsapp-url=whatsappUrl)
									svg(class='w-6 h-6 shrink-0 text-green-500' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true')
										path(d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z')
									div(class='text-left')
										span(class='contact-actions__label contact-actions__label--whatsapp')= t.contact.whatsappTitle
								button(type='button' class='contact-actions__item contact-actions__email contact-cta-trigger' data-open-lead-modal='email' data-email-url='mailto:' + contactEmail)
									svg(class='w-6 h-6 shrink-0 text-nw-accent' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z')
									span(class='contact-actions__label')= t.contact.emailTitle
								button(type='button' class='contact-actions__item contact-cta-trigger' data-open-lead-modal='phone')
									svg(class='w-6 h-6 shrink-0 text-nw-accent' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 5a2 2 0 012-2h3.2a1 1 0 01.98.8l.7 3a1 1 0 01-.27.95l-1.4 1.4a16 16 0 007.44 7.44l1.4-1.4a1 1 0 01.95-.27l3 .7a1 1 0 01.8.98V19a2 2 0 01-2 2h-1C10.3 21 3 13.7 3 4V5z')
									span(class='contact-actions__label')= t.contact.phoneTitle

					div(class='flex flex-col items-center justify-center text-center')
						p(class='text-sm l:text-base font-bold uppercase tracking-[0.12em] l:tracking-[0.2em] text-nw-accent mb-6')= t.contact.qrTitle
						button(type='button' class='relative p-6 bg-nw-surface rounded-2xl shadow-card contact-cta-trigger' data-open-lead-modal='whatsapp' data-whatsapp-url=whatsappUrl aria-label=t.contact.whatsappTitle)
							div(class='absolute top-3 left-3 w-8 h-8 border-t-2 border-l-2 border-nw-accent rounded-tl-lg')
							div(class='absolute top-3 right-3 w-8 h-8 border-t-2 border-r-2 border-nw-accent rounded-tr-lg')
							div(class='absolute bottom-3 left-3 w-8 h-8 border-b-2 border-l-2 border-nw-accent rounded-bl-lg')
							div(class='absolute bottom-3 right-3 w-8 h-8 border-b-2 border-r-2 border-nw-accent rounded-br-lg')
							div(class='w-48 h-48 m:w-56 m:h-56 flex items-center justify-center bg-nw-bg rounded-lg overflow-hidden')
								img(
									src=whatsappQrSrc
									alt=t.contact.qrAlt
									class='w-full h-full object-contain p-2'
									width='224'
									height='224'
									loading='lazy'
								)
						p(class='font-secondary text-xs l:text-sm text-nw-text-muted mt-4 max-w-xs')= t.contact.qrHint
						button(type='button' class='mt-2 text-xs l:text-sm font-semibold uppercase tracking-widest text-nw-accent hover:underline contact-cta-trigger' data-open-lead-modal='whatsapp' data-whatsapp-url=whatsappUrl)= t.contact.openWhatsapp

			div(class='lead-modal hidden' id='lead-modal-whatsapp' aria-hidden='true')
				div(class='lead-modal__backdrop' data-close-lead-modal='whatsapp')
				div(class='lead-modal__panel' role='dialog' aria-modal='true' aria-labelledby='lead-modal-whatsapp-title')
					div(class='lead-modal__header')
						h3(id='lead-modal-whatsapp-title' class='lead-modal__title')= t.contact.modalWhatsAppTitle
						button(type='button' class='lead-modal__close' data-close-lead-modal='whatsapp' aria-label=t.contact.modalClose) ×
					form(class='lead-form' data-lead-form='whatsapp' novalidate)
						label(class='lead-modal__label' for='lead-whatsapp-name')= t.contact.fieldName
						input(id='lead-whatsapp-name' name='full_name' type='text' required class='lead-modal__input')
						label(class='lead-modal__label' for='lead-whatsapp-service')= t.contact.fieldService
						select(id='lead-whatsapp-service' name='service_interest' required class='lead-modal__input')
							option(value='')= t.contact.servicePlaceholder
							each serviceOption in t.contact.serviceOptions
								option(value=serviceOption)= serviceOption
						label(class='lead-modal__label' for='lead-whatsapp-number')= t.contact.fieldWhatsapp
						input(id='lead-whatsapp-number' name='whatsapp_number' type='text' required class='lead-modal__input')
						label(class='lead-modal__label' for='lead-whatsapp-message')= t.contact.fieldMessage
						textarea(id='lead-whatsapp-message' name='message' rows='4' required class='lead-modal__textarea')
						p(class='lead-modal__feedback' data-lead-feedback='whatsapp' aria-live='polite')
						button(type='submit' class='lead-modal__submit' data-lead-submit='whatsapp')= t.contact.modalSubmit

			div(class='lead-modal hidden' id='lead-modal-email' aria-hidden='true')
				div(class='lead-modal__backdrop' data-close-lead-modal='email')
				div(class='lead-modal__panel' role='dialog' aria-modal='true' aria-labelledby='lead-modal-email-title')
					div(class='lead-modal__header')
						h3(id='lead-modal-email-title' class='lead-modal__title')= t.contact.modalEmailTitle
						button(type='button' class='lead-modal__close' data-close-lead-modal='email' aria-label=t.contact.modalClose) ×
					form(class='lead-form' data-lead-form='email' novalidate)
						label(class='lead-modal__label' for='lead-email-name')= t.contact.fieldName
						input(id='lead-email-name' name='full_name' type='text' required class='lead-modal__input')
						label(class='lead-modal__label' for='lead-email-service')= t.contact.fieldService
						select(id='lead-email-service' name='service_interest' required class='lead-modal__input')
							option(value='')= t.contact.servicePlaceholder
							each serviceOption in t.contact.serviceOptions
								option(value=serviceOption)= serviceOption
						label(class='lead-modal__label' for='lead-email-phone')= t.contact.fieldPhone
						input(id='lead-email-phone' name='phone' type='text' required class='lead-modal__input')
						label(class='lead-modal__label' for='lead-email-address')= t.contact.fieldEmail
						input(id='lead-email-address' name='email' type='email' required class='lead-modal__input')
						label(class='lead-modal__label' for='lead-email-message')= t.contact.fieldMessage
						textarea(id='lead-email-message' name='message' rows='4' required class='lead-modal__textarea')
						p(class='lead-modal__feedback' data-lead-feedback='email' aria-live='polite')
						button(type='submit' class='lead-modal__submit' data-lead-submit='email')= t.contact.modalSubmit

			div(class='lead-modal hidden' id='lead-modal-phone' aria-hidden='true')
				div(class='lead-modal__backdrop' data-close-lead-modal='phone')
				div(class='lead-modal__panel' role='dialog' aria-modal='true' aria-labelledby='lead-modal-phone-title')
					div(class='lead-modal__header')
						h3(id='lead-modal-phone-title' class='lead-modal__title')= t.contact.modalPhoneTitle
						button(type='button' class='lead-modal__close' data-close-lead-modal='phone' aria-label=t.contact.modalClose) ×
					form(class='lead-form' data-lead-form='phone' novalidate)
						label(class='lead-modal__label' for='lead-phone-name')= t.contact.fieldName
						input(id='lead-phone-name' name='full_name' type='text' required class='lead-modal__input')
						label(class='lead-modal__label' for='lead-phone-service')= t.contact.fieldService
						select(id='lead-phone-service' name='service_interest' required class='lead-modal__input')
							option(value='')= t.contact.servicePlaceholder
							each serviceOption in t.contact.serviceOptions
								option(value=serviceOption)= serviceOption
						label(class='lead-modal__label' for='lead-phone-number')= t.contact.fieldPhoneOnly
						input(id='lead-phone-number' name='phone' type='text' required class='lead-modal__input')
						p(class='lead-modal__feedback' data-lead-feedback='phone' aria-live='polite')
						button(type='submit' class='lead-modal__submit' data-lead-submit='phone')= t.contact.modalCallNow
						button(type='button' class='lead-modal__submit lead-modal__submit--alt contact-cta-trigger' data-lead-request-contact='phone')= t.contact.modalRequestContact
					div(class='lead-call-options hidden' data-call-options='phone')
						div(class='lead-call-options__row')
							p(class='lead-call-options__location') San Rafael, Alajuela
							a(href='tel:+50670187930' target='_blank' rel='noopener noreferrer' class='lead-call-options__link contact-cta-trigger')
								svg(class='w-5 h-5 shrink-0 text-nw-accent' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true')
									path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 5a2 2 0 012-2h3.2a1 1 0 01.98.8l.7 3a1 1 0 01-.27.95l-1.4 1.4a16 16 0 007.44 7.44l1.4-1.4a1 1 0 01.95-.27l3 .7a1 1 0 01.8.98V19a2 2 0 01-2 2h-1C10.3 21 3 13.7 3 4V5z')
								span +506 7018-7930
							button(type='button' class='lead-copy-btn contact-cta-trigger' data-copy-phone='+506 7018-7930' aria-label='Copiar número +506 7018-7930' title='Copiar número')
								svg(class='w-4 h-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
									path(stroke-linecap='round' stroke-linejoin='round' d='M9 9h10v10H9z')
									path(stroke-linecap='round' stroke-linejoin='round' d='M5 15H4a1 1 0 01-1-1V4a1 1 0 011-1h10a1 1 0 011 1v1')
						div(class='lead-call-options__row')
							p(class='lead-call-options__location') Desamparados, San José
							a(href='tel:+50670118183' target='_blank' rel='noopener noreferrer' class='lead-call-options__link contact-cta-trigger')
								svg(class='w-5 h-5 shrink-0 text-nw-accent' fill='none' stroke='currentColor' viewBox='0 0 24 24' aria-hidden='true')
									path(stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M3 5a2 2 0 012-2h3.2a1 1 0 01.98.8l.7 3a1 1 0 01-.27.95l-1.4 1.4a16 16 0 007.44 7.44l1.4-1.4a1 1 0 01.95-.27l3 .7a1 1 0 01.8.98V19a2 2 0 01-2 2h-1C10.3 21 3 13.7 3 4V5z')
								span +506 7011-8183
							button(type='button' class='lead-copy-btn contact-cta-trigger' data-copy-phone='+506 7011-8183' aria-label='Copiar número +506 7011-8183' title='Copiar número')
								svg(class='w-4 h-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
									path(stroke-linecap='round' stroke-linejoin='round' d='M9 9h10v10H9z')
									path(stroke-linecap='round' stroke-linejoin='round' d='M5 15H4a1 1 0 01-1-1V4a1 1 0 011-1h10a1 1 0 011 1v1')
