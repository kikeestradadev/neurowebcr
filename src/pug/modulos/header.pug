div(class='main-container')
	div(class='l:hidden relative flex items-center justify-center h-[var(--header-height)]')
		div(class='max-w-[250px]')
			+logoHorizontal()
		button.menu-toggle(
			type='button'
			id='menu-toggle'
			class='absolute right-0 top-1/2 -translate-y-1/2'
			aria-label=t.nav.openMenu
			aria-expanded='false'
			aria-controls='mobile-nav'
			data-label-open=t.nav.openMenu
			data-label-close=t.nav.closeMenu
		)
			span.menu-toggle__bar(aria-hidden='true')
			span.menu-toggle__bar(aria-hidden='true')
			span.menu-toggle__bar(aria-hidden='true')

	div(class='hidden l:flex items-center justify-between h-[var(--header-height)] gap-4')
		+logoHorizontal()
		nav(class='flex items-center gap-6 xl:gap-8' aria-label=t.nav.ariaMain)
			a(href='#inicio' class='nav-link')= t.nav.home
			a(href='#servicios' class='nav-link')= t.nav.services
			a(href='#portafolio' class='nav-link')= t.nav.portfolio
			a(href='#contacto' class='nav-link')= t.nav.contact

		div(class='flex items-center gap-2 shrink-0')
			+langSwitcher()
			+themeToggle(t.theme.toggleLabel)

	nav#mobile-nav.mobile-nav(class='l:hidden' aria-label=t.nav.ariaMobile hidden)
		ul(class='flex flex-col py-4 gap-1')
			li(class='px-2 pb-2')
				div(class='flex items-center justify-center gap-3')
					+langSwitcher()
					+themeToggle(t.theme.toggleLabel)
			li: a(href='#inicio' class='mobile-nav-link block px-2 py-3 text-sm font-medium uppercase tracking-widest text-nw-text hover:text-nw-accent transition-colors')= t.nav.home
			li: a(href='#servicios' class='mobile-nav-link block px-2 py-3 text-sm font-medium uppercase tracking-widest text-nw-text hover:text-nw-accent transition-colors')= t.nav.services
			li: a(href='#portafolio' class='mobile-nav-link block px-2 py-3 text-sm font-medium uppercase tracking-widest text-nw-text hover:text-nw-accent transition-colors')= t.nav.portfolio
			li
				button(type='button' class='mobile-nav-link block w-full text-left px-2 py-3 text-sm font-medium uppercase tracking-widest text-nw-text hover:text-nw-accent transition-colors' data-open-lead-modal='whatsapp' data-whatsapp-url=whatsappUrl)= t.nav.contact
			li(class='pt-2')
				button(type='button' class='mobile-nav-cta contact-cta-trigger inline-flex items-center justify-center text-center px-5 py-3 bg-nw-accent text-white text-xs font-semibold uppercase tracking-widest rounded-full' data-open-lead-modal='whatsapp' data-whatsapp-url=whatsappUrl)= t.nav.cta
