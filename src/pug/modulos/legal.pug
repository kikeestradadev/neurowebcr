section(id='legal' class='section-base relative py-20 l:py-24')
	div(class='main-container')
		div(class='container')
			div(class='text-center max-w-3xl mx-auto mb-12 l:mb-14')
				p(class='text-xs l:text-sm font-semibold uppercase tracking-[0.3em] text-nw-accent mb-3')= t.legal.eyebrow
				h2(class='text-3xl l:text-5xl font-bold uppercase tracking-tight text-nw-text')= t.legal.title
				p(class='font-secondary mt-4 text-base l:text-lg text-nw-text-muted leading-relaxed')= t.legal.intro

			div(class='grid grid-cols-1 m:grid-cols-2 l:grid-cols-3 gap-4 l:gap-5')
				each item, index in t.legal.items
					article(class='p-6 l:p-7 border border-nw-surface-muted rounded-2xl bg-nw-surface shadow-card')
						div(class='flex items-center gap-4')
							div(class='w-12 h-12 rounded-xl border border-nw-surface-muted bg-nw-bg flex items-center justify-center shrink-0')
								if index === 0
									svg(class='w-5 h-5 text-nw-accent' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' d='M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z')
										path(stroke-linecap='round' stroke-linejoin='round' d='M9.5 12.5l1.8 1.8 3.2-3.2')
								else if index === 1
									svg(class='w-5 h-5 text-nw-accent' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' d='M8 3h8l3 3v15H5V3h3z')
										path(stroke-linecap='round' stroke-linejoin='round' d='M8 9h8M8 13h8M8 17h5')
								else if index === 2
									svg(class='w-5 h-5 text-nw-accent' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
										ellipse(cx='12' cy='6' rx='7' ry='3')
										path(stroke-linecap='round' stroke-linejoin='round' d='M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6')
										path(stroke-linecap='round' stroke-linejoin='round' d='M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6')
								else if index === 3
									svg(class='w-5 h-5 text-nw-accent' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' d='M12 4v16M5 8h14M6 20h12')
								else
									svg(class='w-5 h-5 text-nw-accent' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' aria-hidden='true')
										path(stroke-linecap='round' stroke-linejoin='round' d='M4 12h6l2-6 2 12 2-6h4')
							h3(class='text-base l:text-lg font-semibold text-nw-text leading-relaxed')= item.title || item
