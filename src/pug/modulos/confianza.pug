section(id='confianza' class='section-base relative py-20 l:py-28')
	div(class='main-container')
		div(class='container')
			div(class='text-center max-w-3xl mx-auto mb-14 l:mb-16')
				h2(class='text-3xl l:text-5xl font-bold uppercase tracking-tight text-nw-text')= t.trust.title
				p(class='font-secondary mt-4 text-base l:text-lg text-nw-text-muted leading-relaxed')= t.trust.intro

			div(class='grid grid-cols-1 m:grid-cols-2 l:grid-cols-4 gap-5 l:gap-6')
				each item in t.trust.items
					article(class='p-6 l:p-7 border border-nw-surface-muted rounded-2xl bg-nw-surface shadow-card')
						h3(class='text-base l:text-lg font-bold uppercase tracking-wide mb-3 text-nw-text')= item.title
						p(class='font-secondary text-sm l:text-base text-nw-text-muted leading-relaxed')= item.description
