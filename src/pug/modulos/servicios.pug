section(id='servicios' class='section-stripe relative py-20 l:py-28')
	div(class='main-container')
		div(class='container')
			div(class='text-center max-w-2xl mx-auto mb-14 l:mb-20')
				p(class='text-xs l:text-sm font-semibold uppercase tracking-[0.3em] text-nw-accent mb-3')= t.services.eyebrow
				h2(class='text-3xl l:text-5xl font-bold uppercase tracking-tight text-nw-text')= t.services.title
				p(class='font-secondary mt-4 text-base l:text-lg text-nw-text-muted leading-relaxed')= t.services.intro

			div(class='grid grid-cols-1 m:grid-cols-2 l:grid-cols-3 gap-4 l:gap-5')
				each service, index in t.services.items
					- const cardClass = 'service-card group p-8 l:p-10 bg-nw-surface border border-nw-surface-muted rounded-2xl shadow-card'
					article(class=cardClass)
						div(class='service-icon w-14 h-14 mb-6 rounded-xl bg-nw-bg flex items-center justify-center border border-nw-surface-muted')
							if index === 0
								span(class='text-lg font-bold text-nw-text') &lt;/&gt;
							else if index === 1
								span(class='text-sm font-bold text-nw-accent') AI
							else if index === 2
								span(class='text-xl text-nw-accent') ⚙
							else if index === 3
								span(class='text-xl font-bold text-nw-accent') ↗
							else
								span(class='text-xs font-bold text-nw-accent uppercase tracking-wider') WEB3
						h3(class='text-lg l:text-xl font-bold uppercase tracking-wide mb-3 text-nw-text group-hover:text-nw-accent transition-colors')= service.title
						p(class='font-secondary text-sm l:text-base text-nw-text-muted leading-relaxed')= service.description
