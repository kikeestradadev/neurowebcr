section(id='portafolio' class='section-band relative py-20 l:py-28 pattern-dots-band overflow-hidden')
	div(class='absolute top-0 right-0 w-96 h-96 bg-nw-accent/5 rounded-full blur-3xl pointer-events-none')
	div(class='main-container relative z-10')
		div(class='container')
			div(class='flex flex-col l:flex-row l:items-end l:justify-between gap-6 mb-12 l:mb-16')
				div(class='max-w-xl')
					p(class='text-xs font-semibold uppercase tracking-[0.3em] text-nw-accent mb-3')= t.portfolio.eyebrow
					h2(class='text-3xl l:text-4xl font-bold uppercase tracking-tight')= t.portfolio.title
					p(class='font-secondary mt-4 section-band-muted text-sm l:text-base')= t.portfolio.intro
				p(class='hidden l:block text-xs uppercase tracking-widest section-band-muted opacity-70')= t.portfolio.hint

			div(class='portfolio-swiper swiper')
				div(class='swiper-wrapper')
					each item in portfolioItems
						a.swiper-slide.portfolio-card.portfolio-card--link(
							class='h-full rounded-2xl overflow-hidden border bg-nw-band-surface border-[var(--nw-band-border)]'
							href=item.url
							target='_blank'
							rel='noopener noreferrer'
							aria-label=t.portfolio.visitAria + ': ' + item.title
						)
							div(class='aspect-video overflow-hidden')
								img(src=item.image alt='' class='w-full h-full object-cover' loading='lazy' aria-hidden='true')
							div(class='p-6 l:p-8 text-left')
								span(class='inline-block text-xs font-semibold uppercase tracking-widest text-nw-accent mb-2')= item.category
								h3(class='text-xl font-bold uppercase tracking-wide mb-2 text-[var(--nw-band-text)]')= item.title
								p(class='font-secondary text-sm section-band-muted leading-relaxed mb-4')= item.excerpt
								div(class='flex flex-wrap gap-2 mb-4')
									each tag in item.tags.slice(0, 3)
										span(class='portfolio-tag')= tag
								span(class='portfolio-card__cta text-xs font-semibold uppercase tracking-widest text-nw-accent')= t.portfolio.visitSite

				div(class='swiper-button-prev' aria-label=t.portfolio.prev)
				div(class='swiper-button-next' aria-label=t.portfolio.next)
				div(class='swiper-pagination portfolio-swiper__pagination' aria-hidden='false')

			p(class='text-center font-secondary text-sm section-band-muted mt-8')= t.portfolio.footnote
