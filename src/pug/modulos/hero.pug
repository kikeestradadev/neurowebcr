section(id='inicio' class='section-base relative overflow-hidden pattern-dots corner-accent')
	+logoWatermark()

	div(class='main-container relative z-10')
		div(class='container py-16 m:py-20 l:py-28 text-center')
			p(class='animate-fade-up font-secondary text-xs l:text-sm font-medium uppercase tracking-[0.35em] text-nw-text-muted mb-6')= t.hero.tagline

			h1(class='animate-fade-up animate-delay-1 max-w-4xl mx-auto')
				span(class='block text-3xl m:text-4xl l:text-5xl xl:text-6xl font-bold uppercase tracking-tight text-nw-text leading-tight')= t.hero.titleLine1
				span(class='block mt-2 text-4xl m:text-5xl l:text-6xl xl:text-7xl font-bold uppercase tracking-tight text-nw-accent')= t.hero.titleLine2

			p(class='animate-fade-up animate-delay-2 font-secondary max-w-2xl mx-auto mt-8 text-base l:text-lg text-nw-text-muted leading-relaxed')= t.hero.subtitle

			div(class='animate-fade-up animate-delay-3 flex flex-col m:flex-row items-stretch m:items-center justify-center gap-4 mt-10 w-full max-w-[300px] mx-auto m:max-w-none')
				a(href='#contacto' class='inline-flex w-full m:w-auto items-center justify-center px-8 py-3.5 bg-nw-text text-nw-bg text-sm font-semibold uppercase tracking-widest rounded-full hover:opacity-90 transition-opacity')= t.hero.ctaPrimary
				a(href='#servicios' class='inline-flex w-full m:w-auto items-center justify-center px-8 py-3.5 border-2 border-nw-text text-nw-text text-sm font-semibold uppercase tracking-widest rounded-full hover:bg-nw-text hover:text-nw-bg transition-colors')= t.hero.ctaSecondary

			div(class='animate-fade-up animate-delay-3 w-16 h-1 bg-nw-accent mx-auto mt-12 rounded-full')

			div(class='mt-12 grid grid-cols-2 m:grid-cols-3 l:grid-cols-6 gap-3 l:gap-4 max-w-6xl mx-auto')
				div(class='text-center p-3 l:p-3.5 rounded-lg border border-nw-surface-muted bg-[var(--nw-card)]')
					p(class='text-xl l:text-2xl font-bold text-nw-accent leading-none') 10+
					p(class='font-secondary text-[11px] l:text-xs text-nw-text-muted mt-1 uppercase tracking-wide')= t.hero.stat1Label
				div(class='text-center p-3 l:p-3.5 rounded-lg border border-nw-surface-muted bg-[var(--nw-card)]')
					p(class='text-xl l:text-2xl font-bold text-nw-accent leading-none') 100%
					p(class='font-secondary text-[11px] l:text-xs text-nw-text-muted mt-1 uppercase tracking-wide')= t.hero.stat2Label
				div(class='text-center p-3 l:p-3.5 rounded-lg border border-nw-surface-muted bg-[var(--nw-card)]')
					p(class='text-xl l:text-2xl font-bold text-nw-accent leading-none')= t.hero.stat3Value
					p(class='font-secondary text-[11px] l:text-xs text-nw-text-muted mt-1 uppercase tracking-wide')= t.hero.stat3Label
				div(class='text-center p-3 l:p-3.5 rounded-lg border border-nw-surface-muted bg-[var(--nw-card)]')
					p(class='text-xl l:text-2xl font-bold text-nw-accent leading-none') CR
					p(class='font-secondary text-[11px] l:text-xs text-nw-text-muted mt-1 uppercase tracking-wide')= t.hero.stat4Label
				div(class='text-center p-3 l:p-3.5 rounded-lg border border-nw-surface-muted bg-[var(--nw-card)]')
					p(class='text-xl l:text-2xl font-bold text-nw-accent leading-none') WEB
					p(class='font-secondary text-[11px] l:text-xs text-nw-text-muted mt-1 uppercase tracking-wide')= t.hero.stat5Label
				div(class='text-center p-3 l:p-3.5 rounded-lg border border-nw-surface-muted bg-[var(--nw-card)]')
					p(class='text-xl l:text-2xl font-bold text-nw-accent leading-none') SEO
					p(class='font-secondary text-[11px] l:text-xs text-nw-text-muted mt-1 uppercase tracking-wide')= t.hero.stat6Label
